<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Sales Dashboard (ECharts)</masterLabel>
    <description>Opportunity 기반 영업 대시보드: KPI, 월별 실적 vs 목표, 게이지, 퍼널, Sankey, Treemap, Scatter, 캘린더 히트맵, 드릴다운 목록</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="cardTitle" type="String" label="카드 제목" default="Sales Dashboard"/>
            <property name="annualTarget" type="String" label="연간 매출 목표 금액" default="10000000"
                description="사용자 통화 기준 숫자만 입력 (예: 10000000). 비우면 목표 관련 지표를 표시하지 않음"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
